<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_connect_sheet" android:orientation="vertical" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/refresh" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/refresh" app:tint="@color/connect_action_text" android:background="@drawable/bg_connect_action" android:clickable="true" android:focusable="true"/>
        <ImageView android:visibility="gone" android:id="@+id/connect_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:contentDescription="@string/offline_back" android:src="@drawable/abc_ic_ab_back_material" app:tint="@color/connect_action_text" android:background="@drawable/bg_connect_action" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Connect" android:textColor="@color/app_text" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_marginStart="16dp" android:layout_marginEnd="12dp"/>
        <ImageView android:id="@+id/tuya_settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:padding="12dp" android:src="@drawable/ic_connect_add" android:contentDescription="@string/kugoo_add_device" android:background="@drawable/bg_connect_action" android:clickable="true" android:focusable="true" android:visibility="gone" app:tint="@color/connect_action_text"/>
        <ImageView android:id="@+id/tuya_login" android:layout_width="48dp" android:layout_height="48dp" android:padding="7dp" android:src="@drawable/kugoo_logo" android:scaleType="fitCenter" android:contentDescription="@string/kugoo_saved_title" android:background="@drawable/bg_connect_action" android:clickable="true" android:focusable="true"/>
        <ImageView android:id="@+id/connect" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/id" app:tint="@color/connect_action_text" android:background="@drawable/bg_connect_action" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/linear1" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="@android:color/transparent" android:gravity="center" android:minHeight="200dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/base_block" android:orientation="vertical" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/saved_kugoo_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
                <ImageView android:id="@+id/kugoo_empty" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center_horizontal" android:src="@drawable/scooter_empty" android:scaleType="centerInside" app:tint="@color/app_text_secondary" android:importantForAccessibility="no" android:visibility="gone"/>
                <ScrollView android:id="@+id/saved_kugoo_scroll" android:layout_width="match_parent" android:layout_height="260dp" android:fillViewport="false" android:clipToPadding="false">
                    <LinearLayout android:id="@+id/saved_kugoo_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </ScrollView>
                <TextView android:id="@+id/kugoo_connect_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/app_text_secondary" android:textSize="14sp" android:accessibilityLiveRegion="polite" android:visibility="gone" android:background="@drawable/bg_connect_card" android:padding="12dp" android:layout_marginBottom="8dp"/>
            </LinearLayout>
            <ListView android:visibility="gone" android:id="@+id/listview1" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:choiceMode="none" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:listSelector="@drawable/bg_connect_action" android:clipToPadding="false"/>
            <ImageView android:id="@+id/empty" android:visibility="gone" android:src="@drawable/scooter_empty" android:scaleType="centerInside" android:layout_width="100dp" android:layout_height="100dp" app:tint="@color/app_text_secondary"/>
            <ProgressBar android:id="@+id/loading" android:layout_width="50dp" android:layout_height="50dp" android:indeterminateTint="@color/colorAccent"/>
        </LinearLayout>
        <LinearLayout android:visibility="gone" android:orientation="horizontal" android:id="@+id/connect_block" android:layout_width="match_parent" android:gravity="center" android:layout_height="100dp">
            <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="match_parent">
                <EditText android:id="@+id/connect_text" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Address" android:textColor="@color/app_text" android:textColorHint="@color/app_text_secondary" android:backgroundTint="@color/colorAccent" android:singleLine="true"/>
            </LinearLayout>
            <ImageView android:src="@drawable/bluetooth_connect" android:padding="12dp" android:id="@+id/connect_go" android:layout_width="50dp" android:layout_height="50dp" app:tint="@color/colorAccent" android:background="@drawable/bg_connect_action"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
