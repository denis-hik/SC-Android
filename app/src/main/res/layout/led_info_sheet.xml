<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_connect_sheet" android:clipToOutline="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/OfflineTitle" android:text="@string/led_info_title" android:textSize="24sp"/>
        <TextView style="@style/OfflineBody" android:text="@string/led_info_library"/>
        <TextView style="@style/OfflineTitle" android:text="@string/led_info_setup_title" android:layout_marginTop="20dp"/>
        <TextView style="@style/OfflineBody" android:text="@string/led_info_setup"/>
        <TextView style="@style/OfflineTitle" android:text="@string/led_info_destination_title" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/led_info_destination" style="@style/OfflineBody" android:textIsSelectable="true"/>
        <TextView style="@style/OfflineTitle" android:text="@string/led_info_payload_title" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/led_info_payload" style="@style/OfflineBody" android:textIsSelectable="true"/>
        <TextView style="@style/OfflineTitle" android:text="@string/led_info_usage_title" android:layout_marginTop="20dp"/>
        <TextView style="@style/OfflineBody" android:text="@string/led_info_usage"/>
        <TextView style="@style/OfflineTitle" android:text="@string/led_info_bluetooth_title" android:layout_marginTop="20dp"/>
        <TextView style="@style/OfflineBody" android:text="@string/led_info_bluetooth"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/led_info_source" style="@style/OfflineSecondary" android:text="@string/led_info_source"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/led_info_close" style="@style/OfflineButton" android:text="@string/led_info_close"/>
    </LinearLayout>
</ScrollView>
