<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_connect_card" android:padding="8dp" android:minHeight="80dp">
    <LinearLayout android:id="@+id/loading" android:visibility="gone" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center">
        <ProgressBar android:layout_width="40dp" android:layout_height="40dp" android:indeterminateTint="@color/colorAccent"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/linear1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/image" android:focusable="false" android:layout_width="80dp" android:layout_height="70dp" android:padding="10dp" android:src="@drawable/scooter" android:scaleType="centerInside"/>
        <LinearLayout android:id="@+id/linear2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="center_vertical">
            <TextView android:id="@+id/name" android:focusable="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="TextView" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/app_text" android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/des" android:focusable="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="TextView" android:textSize="12sp" android:textColor="@color/app_text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
