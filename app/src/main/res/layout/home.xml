<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:yandex="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent">
		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<com.yandex.mapkit.mapview.MapView
				android:id="@+id/mapview1"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:visibility="invisible"
				yandex:movable="true" />
            <WebView android:id="@+id/dgis_map" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="70dp" android:layout_marginHorizontal="12dp" android:orientation="vertical" android:background="@drawable/sheet_background" android:padding="8dp">
                <TextView android:id="@+id/map_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/app_text" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/clear_route" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Завершить маршрут" android:visibility="gone" />
                <Button android:id="@+id/open_dgis_browser" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Открыть 2ГИС в браузере" android:visibility="gone" />
            </LinearLayout>
            <ImageButton android:id="@+id/locate_me" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="12dp" android:src="@android:drawable/ic_menu_mylocation" android:background="@drawable/sheet_background" android:contentDescription="Моё местоположение" />
			<androidx.cardview.widget.CardView
				android:id="@+id/save_scale_type"
				android:visibility="gone"
				android:layout_alignParentStart="true"
				android:layout_width="50dp"
				android:layout_height="50dp"
				app:cardElevation="10dp"
				app:cardCornerRadius="10dp"
				android:layout_marginLeft="10dp"
				android:layout_marginTop="10dp"
			>
				<LinearLayout
					android:layout_width="match_parent"
					android:background="@color/colorControlNormal"
					android:layout_height="match_parent">
					<TextView
						android:id="@+id/speed"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:text="0"
						android:textSize="29dp"
						android:gravity="center"
						android:textColor="#fff"
				 />
				</LinearLayout>
			</androidx.cardview.widget.CardView>
			<androidx.cardview.widget.CardView
				android:id="@+id/error_block"
				android:visibility="gone"
				android:layout_alignParentEnd="true"
				android:layout_width="50dp"
				android:layout_height="50dp"
				app:cardBackgroundColor="@color/colorControlNormal"
				app:cardElevation="10dp"
				app:cardCornerRadius="10dp"
				android:layout_marginRight="10dp"
				android:layout_marginTop="10dp"
			>
				<ImageView
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/warning"
					android:padding="7dp"
				/>
			</androidx.cardview.widget.CardView>
		</RelativeLayout>
		<ImageView
			android:id="@+id/image"
			android:src="@drawable/scooter1"
			android:layout_width="match_parent"
			android:scaleType="centerInside"
			android:translationX="100dp"
			android:scaleX="-1.5"
			android:scaleY="1.5"
			android:layout_height="match_parent" />
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
			app:behavior_peekHeight="126dp">
			<LinearLayout
				android:id="@+id/route_block"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:orientation="horizontal">
				<androidx.cardview.widget.CardView
					android:id="@+id/home"
					android:layout_width="100dp"
					android:layout_height="match_parent"
					app:cardElevation="10dp"
					android:layout_marginLeft="5dp"
					android:layout_marginBottom="5dp"
					app:cardCornerRadius="20dp"
					app:cardBackgroundColor="@color/colorControlNormal"
				>
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="match_parent">
						<ImageView
							app:tint="#fff"
							android:layout_width="35dp"
							android:layout_height="match_parent"
							android:padding="5dp"
							android:src="@drawable/home"
						/>
						<TextView
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:gravity="center"
							android:id="@+id/home_label"
                            android:maxLines="1" android:ellipsize="end" android:text="Дом"
							android:layout_marginRight="5dp"
							android:textSize="17sp"
							android:textColor="#fff"
						/>
					</LinearLayout>
				</androidx.cardview.widget.CardView>
				<androidx.cardview.widget.CardView
					android:id="@+id/garden"
					android:layout_width="120dp"
					android:layout_height="match_parent"
					app:cardElevation="10dp"
					android:layout_marginLeft="5dp"
					android:layout_marginBottom="5dp"
					app:cardCornerRadius="20dp"
					app:cardBackgroundColor="@color/colorControlNormal"
				>
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="match_parent">
						<ImageView
							app:tint="#fff"
							android:layout_width="35dp"
							android:layout_height="match_parent"
							android:padding="5dp"
							android:src="@drawable/garden"
						/>
						<TextView
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:gravity="center"
							android:id="@+id/garden_label"
                            android:maxLines="1" android:ellipsize="end" android:text="Дача"
							android:layout_marginRight="5dp"
							android:textSize="17sp"
							android:textColor="#fff"
						/>
					</LinearLayout>
				</androidx.cardview.widget.CardView>                <ImageButton android:id="@+id/edit_places" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:src="@drawable/ic_edit_place" android:background="@drawable/sheet_background" android:padding="12dp" android:contentDescription="Редактировать места" />
                <ImageButton android:id="@+id/search_route" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:src="@drawable/ic_search_route" android:background="@drawable/sheet_background" android:padding="12dp" android:contentDescription="Найти адрес для временного маршрута" />

			</LinearLayout>
			<LinearLayout
				android:gravity="center"
				android:padding="8dp"
				android:background="@drawable/sheet_background"
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<androidx.cardview.widget.CardView
					android:layout_width="40dp"
					android:layout_height="4dp"
					app:cardCornerRadius="10dp"
					app:cardElevation="0dp"
					>
					<LinearLayout
						android:id="@+id/linear13"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:background="@color/app_outline"
						android:orientation="horizontal" />
				</androidx.cardview.widget.CardView>

				<TextView
					android:id="@+id/textview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:padding="8dp"
					android:text="Midway i pro"
					android:textSize="20sp"
					android:textStyle="bold"
					android:textColor="@color/app_text" />
				<LinearLayout
					android:id="@+id/linear4"
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:padding="8dp"
					android:background="@color/app_outline"
					android:orientation="horizontal" />
				<LinearLayout
					android:id="@+id/linear16"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal" />
				<sc.denishik.ru.other.CustomViewPager
					android:id="@+id/viewpage"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					/>
			</LinearLayout>

		</LinearLayout>
        <FrameLayout android:id="@+id/speedometer_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <sc.denishik.ru.pages.SpeedometerView android:id="@+id/speedometer_gauge" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageButton android:id="@+id/record_speedometer" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="16dp" android:padding="12dp" android:src="@drawable/ic_record" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Записать экран для видео" />
            <ImageButton android:id="@+id/close_speedometer" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:layout_margin="16dp" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/back" android:tint="#FFFFFF" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Назад" />
        </FrameLayout>
	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
