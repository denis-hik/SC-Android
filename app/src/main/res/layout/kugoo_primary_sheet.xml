<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="16dp"
    android:background="@drawable/bg_connect_sheet">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="72dp" android:padding="8dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/primary_back" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/back" app:tint="@color/connect_action_text"
            android:background="@drawable/bg_connect_action" android:contentDescription="@string/offline_back"
            android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="12dp"
            android:text="@string/kugoo_primary_title" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/app_text" android:accessibilityHeading="true" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:padding="7dp" android:src="@drawable/kugoo_logo" android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="12dp"
        android:text="@string/kugoo_primary_hint" android:textColor="@color/app_text_secondary"
        android:textSize="14sp" />
    <androidx.core.widget.NestedScrollView android:id="@+id/primary_scroll"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:clipToPadding="false">
        <LinearLayout android:id="@+id/primary_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
