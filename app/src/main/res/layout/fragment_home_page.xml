<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".pages.HomePage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/remote"
                android:layout_width="100dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/app_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >
                    <ImageView app:tint="@color/app_text"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:src="@drawable/remote"
                        android:scaleType="centerInside"
                        android:padding="10dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:text="Remote"
                        android:gravity="center"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/info"
                android:layout_width="100dp"
                android:layout_weight="1"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                app:cardBackgroundColor="@color/app_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >
                    <ImageView app:tint="@color/app_text"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:src="@drawable/scooter"
                        android:scaleType="centerInside"
                        android:padding="10dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:text="Info"
                        android:gravity="center"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/leds"
                android:layout_width="100dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/app_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >
                    <ImageView app:tint="@color/app_text"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:src="@drawable/led"
                        android:scaleType="centerInside"
                        android:padding="10dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:text="LED"
                        android:gravity="center"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text"
                        />
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <GridLayout android:id="@+id/map_cards_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="3">
            <androidx.cardview.widget.CardView android:id="@+id/map_card" android:layout_width="0dp"  android:layout_height="70dp" app:cardBackgroundColor="@color/app_card" app:cardCornerRadius="10dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <ImageView app:tint="@color/app_text" android:id="@+id/map_card_icon" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/ic_map_choice" android:padding="10dp" android:scaleType="centerInside" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/map_card_label" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="Яндекс" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/app_text" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/travel_card" android:layout_width="0dp"  android:layout_height="70dp" app:cardBackgroundColor="@color/app_card" app:cardCornerRadius="10dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <ImageView app:tint="@color/app_text" android:id="@+id/travel_card_icon" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/ic_route_scooter" android:padding="10dp" android:scaleType="centerInside" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/travel_card_label" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="Самокат" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/app_text" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/gps_icon_card" android:layout_width="0dp"  android:layout_height="70dp" app:cardBackgroundColor="@color/app_card" app:cardCornerRadius="10dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <ImageView app:tint="@color/app_text" android:id="@+id/gps_icon_card_icon" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/ic_gps_marker" android:padding="10dp" android:scaleType="centerInside" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/gps_icon_card_label" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="Иконка GPS" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/app_text" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/speedometer_card" android:layout_width="0dp" android:layout_height="70dp" app:cardBackgroundColor="@color/app_card" app:cardCornerRadius="10dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="Открыть спидометр">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <ImageView app:tint="@color/app_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/ic_speedometer" android:padding="10dp" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="Спидометр" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/app_text" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/disconnect_card" android:layout_width="0dp" android:layout_height="70dp" app:cardBackgroundColor="@color/app_card" app:cardCornerRadius="10dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="Отключиться от самоката">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <ImageView app:tint="@color/app_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/ic_disconnect" android:padding="10dp" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="Отключиться" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/app_text" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>
        <com.google.android.material.tabs.TabLayout android:id="@+id/travel_tabs" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="10dp" android:visibility="gone" app:tabMode="fixed" app:tabGravity="fill" app:tabTextColor="@color/app_text_secondary" app:tabSelectedTextColor="@color/colorControlNormal" app:tabIndicatorColor="@color/colorControlNormal" app:tabIconTint="@color/travel_tab_color" app:tabTextAppearance="@style/TravelTabText" />
        <TextView android:id="@+id/map_provider_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="12dp" android:text="Нажмите карточку, чтобы изменить настройку" android:textSize="12sp" android:textColor="@color/app_text_secondary" />
        <androidx.cardview.widget.CardView
            android:id="@+id/kurwa_author_link"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/kurwa_author_tiktok"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/app_card">
            <ImageView
                android:id="@+id/kurwa_author_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</FrameLayout>
