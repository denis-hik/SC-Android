<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".pages.LedPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingTop="0dp"
            android:paddingBottom="10dp"
        >
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_marginRight="10dp"
                android:layout_height="match_parent"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorControlHighlight"
                >
                <ImageView
                    android:id="@+id/back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/back"
                    android:tint="@android:color/white"
                    android:padding="5dp"
                />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorControlHighlight"
                >
                <TextView
                    android:id="@+id/ws_url"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="ws://"
                    android:gravity="center"
                />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_marginLeft="10dp"
                android:layout_height="match_parent"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorControlHighlight"
                >
                <ImageView
                    android:id="@+id/refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/refresh"
                    android:tint="@android:color/white"
                    android:padding="5dp"
                    />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_marginLeft="10dp"
                android:layout_height="match_parent"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorControlHighlight"
                >
                <ImageView
                    android:id="@+id/bluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bluetooth"
                    android:tint="@android:color/white"
                    android:padding="5dp"
                    />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorControlHighlight">
                <ImageView
                    android:id="@+id/led_settings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_led_settings"
                    android:tint="@android:color/white"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/led_settings_title"
                    android:focusable="true"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
        <TextView android:id="@+id/ble_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:layout_marginTop="12dp" android:background="@drawable/bg_connect_card" android:textColor="@color/app_text" android:textSize="18sp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <ListView
            android:dividerHeight="8dp"
            android:divider="@android:color/transparent"
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        />
    </LinearLayout>

</FrameLayout>
